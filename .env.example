# ---- keys (generate with: pnpm keys) ----
# SPONSOR pays every Stellar fee and sponsors account reserves. OWNER/AGENT are only for the legacy single-user scripts.
SPONSOR_SECRET=
OWNER_SECRET=
AGENT_SECRET=

# ---- external services ----
# DeFindex console -> API Keys (sk_...). Leave empty until obtained: vault steps are skipped (never mocked).
DEFINDEX_API_KEY=
X402_FACILITATOR_URL=https://x402.org/facilitator
# Optional OpenZeppelin facilitator for stellar:testnet (key from https://channels.openzeppelin.com/testnet/gen)
OZ_FACILITATOR_API_KEY=

# ---- written by `pnpm bootstrap` ----
SMART_ACCOUNT_ID=
AGENT_RULE_ID=
VAULT_ID=                       # optional: the API creates a vault at boot (DEFINDEX_API_KEY set) and keeps its id in the database

# ---- policy / autopilot ----
AGENT_DAILY_CAP_USDC=10
YIELD_RESERVE_USDC=5
BASE_BRIDGE_MIN_USDC=1          # smallest CCTP bridge for a Base payment (a float for the next ones); 0.01 = bridge only what the paywall asks
BOOTSTRAP_ONRAMP_TRY=3000
AUTOPILOT=on

# ---- api ----
API_BEARER_TOKEN=change-me
PUBLIC_API_URL=http://localhost:3000
RESOURCE_SERVER_URL=http://localhost:4000   # optional: demo paywalls (apps/resource-server); leave empty in production
EVENTS_FILE=./data/events.jsonl
PORT=3000
LOG_LEVEL=info

# ---- resource server (merchant) ----
# Defaults: MERCHANT_STELLAR_ADDRESS = owner public key, MERCHANT_EVM_ADDRESS = an app-owned Privy wallet ("pera-merchant")
MERCHANT_STELLAR_ADDRESS=
MERCHANT_EVM_ADDRESS=

# ---- multi-user (passkey login, Postgres, Privy) ----
# Postgres connection (Dokploy service). Unset → embedded PGlite under ./data/pglite for local dev.
DATABASE_URL=
# Encrypts custodial Stellar secrets at rest (AES-256-GCM). Any string ≥16 chars; rotate = re-encrypt.
WALLET_MASTER_KEY=
# WebAuthn relying party (the dashboard's domain) and allowed origins (comma-separated).
PASSKEY_RP_ID=localhost
PASSKEY_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Privy (REQUIRED for sign-up and every EVM action): every user gets a Privy server wallet at sign-up (linked to a Privy
# user via custom_auth = our user id); gas on Base Sepolia is sponsored by Privy. Dashboard: enable TEE execution +
# Fee sponsorship (Base Sepolia) + billing. The API still boots without these (status/MCP/Stellar work) but sign-up
# and EVM calls answer 503 PRIVY_NOT_CONFIGURED.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_GAS_SPONSORSHIP=on
