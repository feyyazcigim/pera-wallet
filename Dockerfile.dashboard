# Dashboard (landing + app) — Dokploy Application "dashboard":
#   Build Type Dockerfile, Docker File "Dockerfile.dashboard", Docker Context Path "." (repo root),
#   Build Args: VITE_API_URL=https://api.<domain>   (optional, see apps/dashboard/src/app/api.ts for the default)
#   Domain: <domain> -> container port 80.
FROM node:22-alpine AS build
ARG VITE_API_URL
ARG VITE_RESOURCE_SERVER_URL
ENV VITE_API_URL=$VITE_API_URL VITE_RESOURCE_SERVER_URL=$VITE_RESOURCE_SERVER_URL
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile --filter @pera/dashboard
RUN pnpm --filter @pera/dashboard build

FROM nginx:alpine
COPY apps/dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/dashboard/dist /usr/share/nginx/html
EXPOSE 80
